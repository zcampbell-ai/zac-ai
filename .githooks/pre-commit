#!/bin/sh
#
# Blocks a commit if Gitleaks finds a likely secret in the staged diff.
# See DECISIONS.md D022. Git runs hooks with the working directory set to
# the repository root, so the relative paths below are correct regardless
# of where `git commit` was invoked from.
#
# To allowlist a specific known-fake value (e.g. a test fixture), add a
# trailing `gitleaks:allow` comment on that exact line rather than editing
# this script or .gitleaks.toml.

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found - commit blocked." >&2
    echo "Install it with: brew install gitleaks" >&2
    exit 1
fi

gitleaks git --staged --redact --config .gitleaks.toml .
